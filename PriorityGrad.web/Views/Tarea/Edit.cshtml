@model PriorityGrad.domain.Models.Tarea

@{
    ViewData["Title"] = "Editar Tarea";
}

<div class="glass-box">
    <h2>Editar Tarea</h2>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
        <input type="hidden" asp-for="Id" />
        <!-- Campo oculto vital para conservar el correo del usuario al actualizar -->
        <input type="hidden" asp-for="UsuarioEmail" />
        
        <div class="mb-3">
            <label class="form-label">Título</label>
            <input asp-for="Titulo" class="form-control" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Materia</label>
                <input asp-for="Materia" class="form-control" />
            </div>
            
            <div class="col-md-3 mb-3">
                <label class="form-label">Color de Fondo</label>
                <input asp-for="ColorHex" type="color" class="form-control form-control-color w-100" />
            </div>

            <div class="col-md-3 mb-3">
                <label class="form-label">Color de Texto</label>
                <input asp-for="ColorTexto" type="color" class="form-control form-control-color w-100" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Valor</label>
            <input asp-for="Valor" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Dificultad</label>
            <input asp-for="Dificultad" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Fecha</label>
            <input asp-for="Fecha" type="date" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Comentario (Opcional - Burbuja de texto)</label>
            <textarea asp-for="Comentario" class="form-control" rows="2" placeholder="Escribe el texto rápido para la burbuja aquí..."></textarea>
        </div>

        <hr class="border-secondary my-4" />
        <h4 class="text-light mb-3">Detalles Adicionales</h4>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Nombre del Profesor</label>
                <input asp-for="NombreProfesor" class="form-control" placeholder="Ej. Ing. Carlos" />
            </div>
            
            <div class="col-md-6 mb-3">
                <label class="form-label">Hora de Entrega</label>
                <input asp-for="HoraEntrega" type="time" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Instrucciones Detalladas</label>
            <textarea asp-for="Instrucciones" class="form-control" rows="4" placeholder="Pega aquí los detalles completos o rúbrica de la tarea..."></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">URL de la Imagen (Opcional)</label>
            <input asp-for="ImagenUrl" type="url" class="form-control" placeholder="Ej. https://i.imgur.com/tu-imagen.png" />
            <small class="text-muted">Pega un enlace de la imagen o captura de las instrucciones.</small>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            <a href="@(Context.Request.Query["returnUrl"].ToString() ?? Url.Action("Index"))"
               class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>