@model PriorityGrad.domain.Models.Tarea
@{
    ViewData["Title"] = "Editar Tarea";
}

<div class="glass-box">
    <h2>Editar Tarea</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="returnUrl" value="@Context.Request.Headers["Referer"].ToString()" />

        <div class="mb-3">
            <label class="form-label">Materia</label>
            <input asp-for="Materia" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Valor</label>
            <input asp-for="Valor" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Dificultad</label>
            <input asp-for="Dificultad" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Fecha</label>
            <input asp-for="Fecha" type="date" class="form-control" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            <a href="javascript:history.back()" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>