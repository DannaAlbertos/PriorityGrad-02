@model PriorityGrad.domain.Models.Tarea
@{
    ViewData["Title"] = "Editar Tarea";
}

<div class="glass-box">
    <h2>Editar Tarea</h2>
    <form asp-action="Edit" method="post">
        <!-- Input oculto para que el controller sepa a dónde regresar al guardar -->
        <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
        <input type="hidden" asp-for="Id" />
        
        <div class="mb-3">
            <label class="form-label">Título</label>
            <input asp-for="Titulo" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Materia</label>
            <input asp-for="Materia" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Valor</label>
            <input asp-for="Valor" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Dificultad</label>
            <input asp-for="Dificultad" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Fecha</label>
            <input asp-for="Fecha" type="date" class="form-control" />
        </div>

        <!-- Nuevo campo para el Tooltip -->
        <div class="mb-3">
            <label class="form-label">Comentario (Opcional)</label>
            <textarea asp-for="Comentario" class="form-control" rows="2" placeholder="Escribe el texto para la burbuja aquí..."></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            
            <!-- Botón Cancelar dinámico -->
            <a href="@(Context.Request.Query["returnUrl"].ToString() ?? Url.Action("Index"))"
               class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>