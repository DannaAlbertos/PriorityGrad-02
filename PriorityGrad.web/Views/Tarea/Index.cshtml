@model IEnumerable<PriorityGrad.domain.Models.Tarea>
@{
    ViewData["Title"] = "Mis Tareas";
}

<div class="glass-box">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dashboard de Tareas</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-neon">➕ Nueva</a>
            <a asp-action="Vencidas" class="btn btn-outline-warning">⚠️ Vencidas</a>
        </div>
    </div>

    <div class="mb-4">
        <span class="text-muted">Ordenar por:</span>
        <div class="btn-group">
            <a asp-action="Index" asp-route-ordenarPor="valor" class="btn btn-sm btn-outline-light">Valor</a>
            <a asp-action="Index" asp-route-ordenarPor="dificultad" class="btn btn-sm btn-outline-light">Dificultad</a>
            <a asp-action="Index" asp-route-ordenarPor="fecha" class="btn btn-sm btn-outline-light">Fecha</a>
        </div>
    </div>

    <table class="table table-dark table-hover align-middle" style="background: transparent;">
        <thead>
            <tr> <th>Materia</th> <th>Valor</th> <th>Dificultad</th> <th>Fecha</th> <th>Estado</th> <th>Acción</th> </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var hoy = DateOnly.FromDateTime(DateTime.Now);
                string estado = item.Fecha >= hoy.AddDays(1) ? "A tiempo" : (item.Fecha >= hoy ? "Retrasado" : "Fuera de tiempo");
                string badgeColor = estado == "A tiempo" ? "success" : (estado == "Retrasado" ? "warning" : "danger");
                <tr>
                    <td>@item.Materia</td>
                    <td>@item.Valor</td>
                    <td>@item.Dificultad</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge bg-@badgeColor text-dark">@estado</span></td>
                    <td>
                        <form asp-action="Eliminar" asp-route-materia="@item.Materia" method="post"
                              onsubmit="return confirm('¿Segura que quieres eliminar @item.Materia?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>