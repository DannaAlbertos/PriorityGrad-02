@model IEnumerable<PriorityGrad.domain.Models.Tarea>

@{ 
    ViewData["Title"] = "Mis Tareas"; 
    var hoy = DateOnly.FromDateTime(DateTime.Now);
}

<style>
    .table-container { border-collapse: separate; border-spacing: 0 12px; }
    .table-container tbody tr { background-color: rgba(255, 255, 255, 0.05); transition: 0.3s; }
    .table-container tbody tr:hover { background-color: rgba(255, 255, 255, 0.1); }
    .table-container td, .table-container th { padding: 18px !important; border: none; }
    .table-container tbody tr td:first-child { border-top-left-radius: 12px; border-bottom-left-radius: 12px; }
    .table-container tbody tr td:last-child { border-top-right-radius: 12px; border-bottom-right-radius: 12px; }
</style>

<div class="glass-box">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dashboard de Tareas</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-neon">➕ Nueva</a>
            <a asp-action="Vencidas" class="btn btn-outline-warning">⚠️ Vencidas</a>
        </div>
    </div>

    <div class="mb-4">
        <span class="text-light fw-bold me-2">Ordenar por:</span>
        <div class="btn-group">
            <a asp-action="Index" asp-route-ordenarPor="valor" class="btn btn-sm btn-outline-light">Valor</a>
            <a asp-action="Index" asp-route-ordenarPor="dificultad" class="btn btn-sm btn-outline-light">Dificultad</a>
            <a asp-action="Index" asp-route-ordenarPor="fecha" class="btn btn-sm btn-outline-light">Fecha</a>
        </div>
    </div>

    <table class="table table-dark table-hover align-middle table-container">
        <thead>
            <tr> 
                <th>Título</th> 
                <th>Materia</th> 
                <th>Valor</th> 
                <th>Dificultad</th> 
                <th>Fecha</th> 
                <th>Estado</th> 
                <th>Acción</th> 
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Where(t => t.Fecha >= hoy))
            {
                string estado = item.Fecha > hoy ? "A tiempo" : "Para hoy";
                string badgeColor = estado == "A tiempo" ? "success" : "warning";
                
                // Leemos los colores directamente de la tarea (con valores por defecto si están vacíos)
                string bgColor = !string.IsNullOrEmpty(item.ColorHex) ? item.ColorHex : "#6c757d";
                string txtColor = !string.IsNullOrEmpty(item.ColorTexto) ? item.ColorTexto : "#ffffff";
                
                <tr>
                    <td>
                        @item.Titulo
                        @if (!string.IsNullOrEmpty(item.Comentario))
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" 
                               class="ms-2 text-decoration-none" 
                               data-bs-toggle="tooltip" 
                               data-bs-placement="top" 
                               title="@item.Comentario (Clic para ver detalles)" 
                               style="cursor: pointer; color: #d4a5a5; font-size: 1.1em;">
                                📝
                            </a>
                        }
                    </td>
                    <td>
                        <span class="badge" style="background-color: @bgColor !important; color: @txtColor !important; padding: 6px 10px;">
                            @item.Materia
                        </span>
                    </td>
                    <td>@item.Valor</td>
                    <td>@item.Dificultad</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge bg-@badgeColor text-dark">@estado</span></td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-outline-info">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@item.Id" asp-route-returnUrl="@Context.Request.Path" method="post" onsubmit="return confirm('¿Segura que quieres eliminar @item.Titulo?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
        });
    </script>
}