@model IEnumerable<PriorityGrad.domain.Models.Tarea>
<div class="glass-box">
    <div class="d-flex justify-content-between mb-4">
        <h2>Dashboard</h2>
        <div>
            <a asp-action="Create" class="btn btn-neon">➕ Nueva</a>
            <a asp-action="Vencidas" class="btn btn-outline-warning">⚠️ Vencidas</a>
        </div>
    </div>
    <div class="mb-3">
        <a asp-action="Index" asp-route-ordenarPor="valor" class="btn btn-sm btn-outline-light">Valor</a>
        <a asp-action="Index" asp-route-ordenarPor="dificultad" class="btn btn-sm btn-outline-light">Dificultad</a>
        <a asp-action="Index" asp-route-ordenarPor="fecha" class="btn btn-sm btn-outline-light">Fecha</a>
    </div>
    <table class="table table-dark table-hover">
        <thead>
            <tr><th>Título</th><th>Materia</th><th>Valor</th><th>Dificultad</th><th>Fecha</th><th>Acción</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Where(t => t.Fecha >= DateOnly.FromDateTime(DateTime.Now)))
            {
                <tr>
                    <td>@item.Titulo</td>
                    <td>@item.Materia</td>
                    <td>@item.Valor</td>
                    <td>@item.Dificultad</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Editar</a>
                        <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Eliminar @item.Titulo?');" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>