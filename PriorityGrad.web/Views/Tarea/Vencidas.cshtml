@model IEnumerable<PriorityGrad.domain.Models.Tarea>
@{
    ViewData["Title"] = "Tareas Vencidas";
}

<div class="glass-box">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Tareas Vencidas</h2>
        <a asp-action="Index" class="btn btn-secondary">Regresar al Dashboard</a>
    </div>

    <table class="table table-dark table-hover align-middle" style="background: transparent;">
        <thead>
            <tr> <th>Materia</th> <th>Valor</th> <th>Dificultad</th> <th>Fecha</th> <th>Acción</th> </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Materia</td>
                    <td>@item.Valor</td>
                    <td>@item.Dificultad</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@item.Id" method="post"
                                  onsubmit="return confirm('¿Segura que quieres eliminar la tarea: @item.Materia?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>