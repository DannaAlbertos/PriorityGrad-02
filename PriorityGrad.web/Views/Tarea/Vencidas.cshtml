@model IEnumerable<PriorityGrad.domain.Models.Tarea>
<div class="glass-box">
    <h2>Tareas Vencidas</h2>
    <a asp-action="Index" class="btn btn-secondary mb-3">Regresar</a>
    <table class="table table-dark table-hover">
        <thead>
            <tr><th>Título</th><th>Materia</th><th>Valor</th><th>Fecha</th><th>Acción</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Titulo</td>
                    <td>@item.Materia</td>
                    <td>@item.Valor</td>
                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Editar</a>
                        <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Eliminar @item.Titulo?');" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>