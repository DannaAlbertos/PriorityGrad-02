@model IEnumerable<PriorityGrad.domain.Models.Tarea>

@{
    ViewData["Title"] = "Tareas Vencidas";
}

<div class="glass-box">
    <h2 class="text-warning mb-4">⚠️ Tareas Vencidas</h2>
    
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p>¡Estás al día! No tienes tareas vencidas. 🎉</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle" style="background: transparent;">
                <thead>
                    <tr>
                        <th>Materia</th>
                        <th>Fecha Límite</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="transition: 0.3s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
                            <td>@item.Materia</td>
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>
                                <!-- Formulario con confirmación incluida -->
                                <form asp-action="Eliminar" asp-route-materia="@item.Materia" method="post"
                                      onsubmit="return confirm('¿Estás segura de que quieres eliminar la tarea vencida de @item.Materia?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-light rounded-pill">Volver al Dashboard</a>
    </div>
</div>