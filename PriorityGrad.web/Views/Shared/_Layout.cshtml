<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PriorityGrad</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background: #0b0e14; color: #e0e0e0; font-family: 'Poppins', sans-serif; min-height: 100vh; }
        .glass-box { background: rgba(20, 25, 35, 0.7); backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 25px; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        .btn-neon { background: linear-gradient(90deg, #ff007f, #6a11cb); border: none; color: white; padding: 8px 20px; border-radius: 50px; font-weight: bold; transition: 0.4s; }
        .btn-neon:hover { filter: brightness(1.2); box-shadow: 0 0 15px #ff007f; color: white; }
        @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .main-wrapper { animation: fadeIn 0.8s ease-in-out; }
        .nav-link { color: #e0e0e0 !important; margin-right: 15px; transition: 0.3s; }
        .nav-link:hover { color: #ff007f !important; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-transparent">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">PriorityGrad</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav">
                    <a class="nav-link" href="/">Home</a>
                    <a class="nav-link" href="/Tarea">Tareas</a>
                    <a class="nav-link" href="/Home/Privacy">Privacy</a>
                </div>
            </div>
        </div>
    </nav>
    <main class="container mt-4 main-wrapper">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>