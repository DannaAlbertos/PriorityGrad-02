@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PriorityGrad</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background: #0b0e14; color: #e0e0e0; font-family: 'Poppins', sans-serif; min-height: 100vh; position: relative; }
        .glass-box { background: rgba(20, 25, 35, 0.7); backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 25px; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        .btn-neon { background: linear-gradient(90deg, #ff007f, #6a11cb); border: none; color: white; padding: 8px 20px; border-radius: 50px; font-weight: bold; transition: 0.4s; text-decoration: none; display: inline-block;}
        .btn-neon:hover { filter: brightness(1.2); box-shadow: 0 0 15px #ff007f; color: white; }
        @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .main-wrapper { animation: fadeIn 0.8s ease-in-out; }
        
        /* Estilo base del botón flotante */
        .menu-toggle-btn {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 1050;
            background: rgba(20, 25, 35, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #fff;
            font-size: 1.2rem;
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            backdrop-filter: blur(15px);
            cursor: pointer;
            box-shadow: 0 5px 20px rgba(0,0,0,0.4);
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .menu-toggle-btn.expanded {
            width: auto;
            height: auto;
            padding: 10px 18px;
            border-radius: 50px;
            font-size: 1.1rem;
        }

        .menu-toggle-btn:hover {
            background: rgba(255, 0, 127, 0.2);
            border-color: #ff007f;
            color: #fff;
            box-shadow: 0 0 15px rgba(255, 0, 127, 0.4);
        }

        .sidebar-menu {
            position: fixed;
            top: 0;
            left: -280px;
            width: 280px;
            height: 100%;
            background: rgba(14, 18, 26, 0.95);
            backdrop-filter: blur(20px);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 1040;
            transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 90px 25px 25px 25px;
            box-shadow: 10px 0 30px rgba(0,0,0,0.6);
        }

        .sidebar-menu.active {
            left: 0;
        }

        .sidebar-menu .nav-link {
            color: #e0e0e0 !important;
            text-decoration: none;
            padding: 12px 16px;
            margin-bottom: 8px;
            border-radius: 12px;
            font-size: 1.05rem;
            transition: 0.3s;
            display: block;
        }

        .sidebar-menu .nav-link:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #ff007f !important;
            transform: translateX(5px);
        }

        /* Estilos nuevos para el saludo superior */
        .user-greeting-container {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1030;
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(20, 25, 35, 0.6);
            backdrop-filter: blur(10px);
            padding: 8px 20px;
            border-radius: 30px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        /* Estilo para el botón inferior del menú lateral (Perfil) */
        .sidebar-footer {
            position: absolute;
            bottom: 25px;
            left: 25px;
            width: calc(100% - 50px);
        }
        .sidebar-footer .nav-link {
            background: rgba(255, 0, 127, 0.1);
            border: 1px solid rgba(255, 0, 127, 0.3);
            text-align: center;
            font-weight: bold;
            color: #ff007f !important;
        }
        .sidebar-footer .nav-link:hover {
            background: rgba(255, 0, 127, 0.2);
            color: #fff !important;
            transform: none;
        }
    </style>
</head>
<body>

    <!-- Botón dinámico del Menú -->
    <button class="menu-toggle-btn" id="menuBtn" title="Abrir Menú PriorityGrad">
        <span id="btnContent">🎓</span>
    </button>

    <!-- Barra Superior Derecha: Saludo y Cierre de Sesión -->
    @{
        var nombreUsuario = Context.Session.GetString("UsuarioNombre");
        if (!string.IsNullOrEmpty(nombreUsuario))
        {
            <div class="user-greeting-container">
                <span class="fs-6 fw-bold text-white">
                     Hola, @nombreUsuario
                </span>
                <a asp-controller="Auth" asp-action="Logout" class="btn-neon" style="padding: 4px 12px; font-size: 0.85rem;">
                    Salir 
                </a>
            </div>
        }
    }

    <!-- Menú Lateral -->
    <div class="sidebar-menu" id="sidebarMenu">
        <h5 class="text-white fw-bold mb-4 px-2">Navegación ✎﹏﹏</h5>
        <div class="nav flex-column">
            <!-- Enlace corregido usando Tag Helpers de ASP.NET Core -->
            <a class="nav-link" asp-controller="Home" asp-action="Index">✧ Inicio</a>
            <a class="nav-link" href="/Tarea">✧ Tareas</a>
            <a class="nav-link" href="/Home/Privacy">✧ Privacidad</a>
        </div>

        <!-- Botón inferior para entrar a la sesión / perfil -->
        <div class="sidebar-footer">
            <a class="nav-link" href="/Perfil">
                (O_O) Mi Sesión
            </a>
        </div>
    </div>

    <!-- Contenido Principal -->
    <main class="container mt-5 pt-5 main-wrapper">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        const menuBtn = document.getElementById('menuBtn');
        const btnContent = document.getElementById('btnContent');
        const sidebarMenu = document.getElementById('sidebarMenu');

        // Detecta en qué ruta estamos en este momento        
        const currentPath = window.location.pathname.toLowerCase();

        // Si estamos en Home o Privacy mostramos el botón completo        
        if (currentPath === "/" || currentPath.includes("/home")) {
            menuBtn.classList.add('expanded');
            btnContent.innerText = "PriorityGrad 🎓";
        } else {
            // En vistas de tareas u otras, se queda solo como emoji compacto
            menuBtn.classList.remove('expanded');
            btnContent.innerText = "🎓";
        }

        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            sidebarMenu.classList.toggle('active');
        });

        document.addEventListener('click', (e) => {
            if (!sidebarMenu.contains(e.target) && !menuBtn.contains(e.target)) {
                sidebarMenu.classList.remove('active');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>