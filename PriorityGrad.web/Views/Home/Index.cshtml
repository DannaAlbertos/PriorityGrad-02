@{
    ViewData["Title"] = "Dashboard Principal";
}

<div class="row justify-content-center">
    <!-- Panel de Bienvenida -->
    <div class="col-md-8 text-center mb-5">
        <h1 class="display-4 fw-bold" style="color: #ffffff;">Bienvenida a <span style="color: #ff007f;">PriorityGrad</span></h1>
        <p class="lead text-secondary">Organiza tu éxito académico de forma inteligente.</p>
    </div>
</div>

<div class="row justify-content-center">
    <!-- Tarjeta de Gestión -->
    <div class="col-md-5">
        <div class="glass-box text-center p-5">
            <h3 class="text-light mb-4">Administrar Tareas</h3>
            <p class="text-secondary mb-4">Gestiona, edita y prioriza tus entregas académicas.</p>
            <a asp-controller="Tarea" asp-action="Index" class="btn btn-neon btn-lg w-100">Ver Dashboard</a>
        </div>
    </div>

    <!-- Tarjeta de Privacidad -->
    <div class="col-md-5">
        <div class="glass-box text-center p-5">
            <h3 class="text-light mb-4">Privacidad</h3>
            <p class="text-secondary mb-4">Consulta cómo protegemos tus datos locales.</p>
            <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-light btn-lg w-100">Ver Política</a>
        </div>
    </div>
</div>

<style>
    .glass-box {
        background: rgba(20, 25, 35, 0.7);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 25px;
        transition: transform 0.3s ease;
    }

        .glass-box:hover {
            transform: translateY(-10px);
            border-color: #ff007f;
        }
</style>