@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center hero-container shadow-lg p-5" style="background: linear-gradient(45deg, #6a11cb, #2575fc); border-radius: 20px; color: white;">
    <h1 class="display-3 fw-bold">PriorityGrad</h1>
    <p class="lead">El flow que tus tareas académicas necesitan.</p>
    <hr class="my-4 border-light">
    <p>¿Listo para organizar tu jornada?</p>
    <a asp-controller="Tarea" asp-action="Index" class="btn btn-lg" style="background: #ff007f; color: white; border-radius: 50px; font-weight: bold;">
        Ver mis tareas ahora
    </a>
</div>

<div class="row mt-5 text-center">
    <div class="col-md-4">
        <div class="card p-3 shadow-sm glass-card">
            <h3>Organización</h3>
            <p>Mantén tus materias bajo control, sin errores y a tiempo.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow-sm glass-card">
            <h3>Prioridad</h3>
            <p>Dificultad alta, valor alto. ¡Tú decides qué reventar primero!</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow-sm glass-card">
            <h3>Flow Vencidas</h3>
            <p>No te pierdas de nada, controla las tareas que ya caducaron.</p>
        </div>
    </div>
</div>